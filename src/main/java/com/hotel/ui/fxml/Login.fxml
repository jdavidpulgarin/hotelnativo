<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.ui.controllers.LoginController"
           prefWidth="1100" prefHeight="700">

    <!-- 1. FONDO — gradiente navy radial; GaussianBlur se aplica desde initialize() -->
    <Pane fx:id="bgPane"
          style="-fx-background-color: radial-gradient(center 50% 40%, radius 80%, #1B2A4A 0%, #0F1D2F 100%);"/>

    <!-- 2. CARD DE LOGIN centrada en el StackPane -->
    <VBox fx:id="formCard" styleClass="login-card" alignment="TOP_CENTER"
          maxWidth="420" spacing="0">

        <!-- A) LOGO -->
        <StackPane styleClass="logo-container" alignment="CENTER">
            <VBox.margin><Insets bottom="20"/></VBox.margin>
            <ImageView fx:id="logoImage" fitWidth="80" fitHeight="80"
                       preserveRatio="true" smooth="true"/>
        </StackPane>

        <!-- B) TEXTO SUPERIOR -->
        <VBox spacing="4" alignment="CENTER">
            <VBox.margin><Insets bottom="24"/></VBox.margin>
            <Label text="SISTEMA DE GESTIÓN HOTELERA"
                   style="-fx-font-size:11; -fx-font-weight:bold; -fx-text-fill:#3B82F6;"/>
            <Label text="¡Bienvenido de nuevo!"
                   style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#1E293B;"/>
            <Label text="Ingrese sus credenciales para acceder al sistema"
                   style="-fx-font-size:13; -fx-text-fill:#94A3B8;"/>
        </VBox>

        <!-- C) CAMPO USUARIO -->
        <VBox spacing="6">
            <VBox.margin><Insets bottom="16"/></VBox.margin>
            <Label text="USUARIO" styleClass="login-label"/>
            <HBox fx:id="emailWrapper" styleClass="login-input-wrapper"
                  alignment="CENTER_LEFT" spacing="10">
                <Label text="✉" style="-fx-font-size:16; -fx-text-fill:#94A3B8; -fx-min-width:22;"/>
                <TextField fx:id="emailField"
                           promptText="usuario@hotel.com"
                           styleClass="login-input"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- D) CAMPO CONTRASEÑA con toggle ojo -->
        <VBox spacing="6">
            <VBox.margin><Insets bottom="8"/></VBox.margin>
            <Label text="CONTRASEÑA" styleClass="login-label"/>
            <HBox fx:id="passwordWrapper" styleClass="login-input-wrapper"
                  alignment="CENTER_LEFT" spacing="10">
                <Label text="🔒" style="-fx-font-size:14; -fx-text-fill:#94A3B8; -fx-min-width:22;"/>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               styleClass="login-input"
                               HBox.hgrow="ALWAYS"/>
                <TextField fx:id="passwordVisible"
                           promptText="••••••••"
                           styleClass="login-input"
                           HBox.hgrow="ALWAYS"
                           visible="false" managed="false"/>
                <Button fx:id="showPasswordBtn" text="👁"
                        style="-fx-background-color:transparent; -fx-border-color:transparent;
                               -fx-text-fill:#94A3B8; -fx-font-size:15; -fx-cursor:hand;
                               -fx-padding:0 2; -fx-pref-height:32;"
                        mnemonicParsing="false"
                        onAction="#togglePasswordVisibility"/>
            </HBox>
        </VBox>

        <!-- E) FILA OPCIONES: Recuérdame + ¿Olvidaste contraseña? -->
        <HBox alignment="CENTER_LEFT">
            <VBox.margin><Insets bottom="20"/></VBox.margin>
            <CheckBox fx:id="rememberCheck" text="Recuérdame"
                      style="-fx-font-size:13; -fx-text-fill:#64748B;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="¿Olvidaste tu contraseña?"
                       styleClass="login-forgot-link"
                       mnemonicParsing="false"
                       onAction="#handleOlvidePassword"/>
        </HBox>

        <!-- F) LABEL ERROR / ÉXITO -->
        <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="360"
               visible="false" alignment="CENTER"
               style="-fx-text-fill:#DC2626; -fx-font-size:12; -fx-text-alignment:center;">
            <VBox.margin><Insets bottom="6"/></VBox.margin>
        </Label>

        <!-- G) BOTÓN LOGIN -->
        <Button fx:id="btnLogin"
                text="INICIAR SESIÓN"
                styleClass="login-btn"
                maxWidth="Infinity"
                mnemonicParsing="false"
                onAction="#handleLogin">
            <VBox.margin><Insets bottom="12"/></VBox.margin>
        </Button>

        <!-- Indicador de carga -->
        <StackPane alignment="CENTER" minHeight="28">
            <VBox.margin><Insets bottom="8"/></VBox.margin>
            <ProgressIndicator fx:id="loadingIndicator"
                               prefWidth="24" prefHeight="24"
                               visible="false"
                               style="-fx-progress-color:#3B82F6;"/>
        </StackPane>

        <!-- H) TEXTO INFERIOR -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="¿No tienes cuenta?"
                   style="-fx-font-size:13; -fx-text-fill:#94A3B8;"/>
            <Hyperlink text="Contacta al administrador"
                       style="-fx-font-size:13; -fx-text-fill:#3B82F6; -fx-border-color:transparent; -fx-padding:0;"/>
        </HBox>

    </VBox>

    <!-- Botón cerrar ventana -->
    <Button text="✕"
            onAction="#handleClose"
            styleClass="btn-close-login"
            StackPane.alignment="TOP_RIGHT"
            translateX="-14" translateY="14"/>

</StackPane>
  
