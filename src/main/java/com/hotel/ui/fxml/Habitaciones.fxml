<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.ui.controllers.HabitacionesController"
      spacing="0" styleClass="main-bg">

    <!-- ── Header con título y botones de acción ── -->
    <HBox style="-fx-padding:24 24 12 24;" alignment="CENTER_LEFT" spacing="0">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Habitaciones" styleClass="section-title"/>
            <Label text="Habitaciones / Gestión de habitaciones" styleClass="section-subtitle"/>
        </VBox>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button mnemonicParsing="false" styleClass="btn-circle,btn-primary" onAction="#nuevaHabitacion">
                <graphic><FontIcon iconLiteral="fas-plus" iconSize="16" iconColor="white"/></graphic>
                <tooltip><Tooltip text="Nueva Habitación" styleClass="tooltip"/></tooltip>
            </Button>
            <Button mnemonicParsing="false" styleClass="btn-circle,btn-outline" onAction="#cargarDatos">
                <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="14" iconColor="#6b7280"/></graphic>
                <tooltip><Tooltip text="Refrescar" styleClass="tooltip"/></tooltip>
            </Button>
        </HBox>
    </HBox>

    <!-- ── Filtros pill/toggle ── -->
    <HBox style="-fx-padding:0 24 14 24;" spacing="10" alignment="CENTER_LEFT">
        <!-- Seleccionado por defecto: fondo oscuro sólido -->
        <Button fx:id="btnTodas" text="Todas" onAction="#filtrarTodas"
                style="-fx-background-color:#1e293b; -fx-text-fill:white;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-background-radius:25; -fx-padding:7 20; -fx-cursor:hand;"/>
        <!-- Disponibles: borde azul -->
        <Button fx:id="btnDisponibles" text="Disponibles" onAction="#filtrarDisponibles"
                style="-fx-background-color:white; -fx-text-fill:#3b82f6;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-background-radius:25; -fx-border-radius:25;
                       -fx-border-color:#3b82f6; -fx-border-width:1.5;
                       -fx-padding:7 20; -fx-cursor:hand;"/>
        <!-- Reservadas: borde naranja -->
        <Button fx:id="btnReservadas" text="Reservadas" onAction="#filtrarReservadas"
                style="-fx-background-color:white; -fx-text-fill:#f97316;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-background-radius:25; -fx-border-radius:25;
                       -fx-border-color:#f97316; -fx-border-width:1.5;
                       -fx-padding:7 20; -fx-cursor:hand;"/>
        <!-- Ocupadas: borde rojo -->
        <Button fx:id="btnOcupadas" text="Ocupadas" onAction="#filtrarOcupadas"
                style="-fx-background-color:white; -fx-text-fill:#ef4444;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-background-radius:25; -fx-border-radius:25;
                       -fx-border-color:#ef4444; -fx-border-width:1.5;
                       -fx-padding:7 20; -fx-cursor:hand;"/>
        <!-- Mantenimiento: borde morado -->
        <Button fx:id="btnMantenimiento" text="Mantenimiento" onAction="#filtrarMantenimiento"
                style="-fx-background-color:white; -fx-text-fill:#8b5cf6;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-background-radius:25; -fx-border-radius:25;
                       -fx-border-color:#8b5cf6; -fx-border-width:1.5;
                       -fx-padding:7 20; -fx-cursor:hand;"/>
    </HBox>

    <!-- ── Badges de resumen ── -->
    <HBox fx:id="statsRow" spacing="8"
          style="-fx-padding:0 24 16 24;" alignment="CENTER_LEFT"/>

    <!-- ── Grid de cards ── -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll"
                style="-fx-background-color:transparent; -fx-border-color:transparent;">
        <VBox style="-fx-padding:0 24 24 24; -fx-background-color:transparent;">
            <FlowPane fx:id="flowPane" hgap="16" vgap="16"
                      style="-fx-background-color:transparent;"/>
        </VBox>
    </ScrollPane>

    <!-- ── Barra de progreso ── -->
    <ProgressBar fx:id="progressBar" maxWidth="Infinity" visible="false"
                 style="-fx-accent:#3563e9; -fx-pref-height:3px;"/>

</VBox>
  
